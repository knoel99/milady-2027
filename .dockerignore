# Build context of the Docker images (infra/docker/Dockerfile*, context = repository root).
# Allowlist: exclude everything (the website, the figures, the data...) then add back
# only what the milady package and the scripts need.
*
!pyproject.toml
!README.md
!LICENSE
!Makefile
!src/
!tests/
!infra/
!experiments/*.py

# Never in an image: secrets, data, caches, built containers.
**/.env
**/__pycache__
**/*.pyc
**/*.egg-info
**/.pytest_cache
infra/**/*.sif
infra/**/*.tar
