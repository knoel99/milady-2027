  {
   "dot": "cyan",
   "title": "Budget",
   "items": [
    "200 USD of API per provider, capped in the console",
    "Equal compute quota, enforced by the broker",
    "E1-E3 results provided: re-running them earns nothing"
   ]
  },
  {
   "dot": "emerald",
   "title": "Measuring progress",
   "items": [
    "Each team quantifies its objectives on day 1: metric, baseline, target, command",
    "Progress = (value − baseline) / (target − baseline), recomputed by the judge from main",
    "Remaining work = objectives not reached and the gap left"
   ]
  },
  {
   "dot": "rose",
   "title": "What counts",
   "items": [
    "Only results the judge reproduces count",
    "Refuting existing work earns as much as a new result",
    "A role call off its prescribed model or effort is penalised"
   ]
  }
