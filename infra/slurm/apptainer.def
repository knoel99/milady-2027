# Apptainer (or SingularityCE) definition of the MilaDy GPU image for Slurm clusters.
#
# Three ways to get milady.sif (see infra/slurm/README-slurm.md):
#   1. from the project's Docker image (recommended, identical to the cloud VM):
#        make image-gpu && make sif          # apptainer build milady.sif docker-daemon://milady:gpu
#      or, if the image is published in a registry:
#        apptainer build milady.sif docker://ghcr.io/knoel99/milady:gpu
#   2. from THIS file (docker://pytorch/pytorch base, without Docker installed):
#        apptainer build --fakeroot milady.sif infra/slurm/apptainer.def   # from the repository root
#   3. Jean Zay: building from a .def file is impossible there (neither root nor fakeroot);
#      build elsewhere (VM, laptop) then copy the .sif to $WORK and authorise it:
#        idrcontmgr cp milady.sif
#
# At run time, the repository is mounted on /opt/milady (editable install): changing the code does not
# require rebuilding the image (infra/slurm/env.sh, function milady_run).

Bootstrap: docker
From: pytorch/pytorch:2.14.1-cuda12.6-cudnn9-runtime

%labels
    org.opencontainers.image.title MilaDy GPU
    org.opencontainers.image.source https://github.com/knoel99/milady-2027
    milady.torch 2.14.1
    milady.cuda 12.6

%help
    MilaDy image (Python 3.12, PyTorch 2.14.1, CUDA 12.6). Example:
      apptainer exec --nv --bind $PWD:/opt/milady milady.sif python -m milady.sweep --help

%files
    pyproject.toml /opt/milady/pyproject.toml
    README.md /opt/milady/README.md
    LICENSE /opt/milady/LICENSE
    milady /opt/milady/milady
    infra/env/requirements-gpu.txt /opt/milady/infra/env/requirements-gpu.txt

%environment
    export MILADY_ROOT=/opt/milady
    export PYTHONUNBUFFERED=1
    export PYTHONNOUSERSITE=1
    export MPLBACKEND=Agg

%post
    set -eu
    # Ubuntu 24.04 system Python (PEP 668): pip installation allowed in the image.
    export DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PIP_ROOT_USER_ACTION=ignore PIP_BREAK_SYSTEM_PACKAGES=1
    apt-get update
    apt-get install -y --no-install-recommends git make ca-certificates
    rm -rf /var/lib/apt/lists/*
    # Pinned dependencies WITHOUT the CUDA stack (torch, triton, nvidia-*, cuda-*) of the base image.
    grep -vE '^(torch|triton|cuda-[a-z-]+|nvidia-[a-z0-9-]+-cu1[0-9])==' /opt/milady/infra/env/requirements-gpu.txt \
        | grep -vE '^--extra-index-url' > /tmp/requirements-nocuda.txt
    pip install -r /tmp/requirements-nocuda.txt
    pip install --no-deps -e /opt/milady
    mkdir -p /opt/milady/data
    chmod -R a+rX /opt/milady

%test
    python -c "import milady, torch, h5py, sqlalchemy; print('milady', milady.__version__, 'torch', torch.__version__, 'cuda', torch.version.cuda)"
