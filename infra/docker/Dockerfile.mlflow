# syntax=docker/dockerfile:1.7
# MLflow tracking server: official image + PostgreSQL driver (psycopg2) and S3 client (boto3).
# Used by the "mlflow" service of docker-compose.yml (built automatically by
# `docker compose build` / `make up`).
FROM ghcr.io/mlflow/mlflow:v3.17.2

RUN --mount=type=secret,id=cacert,required=false \
    if [ -s /run/secrets/cacert ]; then export PIP_CERT=/run/secrets/cacert; fi \
 && pip install --no-cache-dir --root-user-action=ignore "psycopg2-binary==2.9.13" "boto3==1.43.117" \
 && python -c "import mlflow, psycopg2, boto3; print('mlflow', mlflow.__version__)"

# Non-root server (the official image runs as root): metadata is in PostgreSQL and
# artifacts in S3, nothing is written locally outside $HOME; port 5000 (> 1024).
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin mlflow
USER mlflow
WORKDIR /home/mlflow
