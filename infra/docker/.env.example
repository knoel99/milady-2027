# Variables of the MilaDy docker-compose stack — TEMPLATE, no secrets.
#
# The real file is infra/docker/.env (ignored by git). It is generated automatically, with
# random passwords, by:
#   sudo infra/deploy/bootstrap_vm.sh       (cloud VM)
#   make env                                (any machine with Docker)
# or by hand: cp infra/docker/.env.example infra/docker/.env, then replace each "change-me".
#
# Passwords: letters and digits only (they are inserted into connection URLs);
# for example `openssl rand -hex 24`.

# --- Project ------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=milady
# Listening address of the published ports. Keep 127.0.0.1 (access through an SSH tunnel) unless on a private network.
BIND_ADDR=127.0.0.1
# Compute container used by the Makefile: worker (CPU) or worker-gpu (NVIDIA GPU).
MILADY_WORKER=worker
# Prefix of the built images (milady:cpu, milady:gpu, milady:cpu-jupyter).
MILADY_IMAGE=milady
# UID/GID of the host user who owns the repository (files written in the mounted volume).
MILADY_UID=1000
MILADY_GID=1000
# Machine name, recorded in the catalogue and the MFF files (provenance).
MILADY_HOST=docker

# --- PostgreSQL catalogue ----------------------------------------------------------------------
POSTGRES_USER=milady
POSTGRES_PASSWORD=change-me
POSTGRES_DB=milady
DB_PORT=5432

# --- S3 object storage (local MinIO) -----------------------------------------------------------
# MinIO administrator account (web console http://localhost:9001 through an SSH tunnel).
S3_ROOT_USER=milady-admin
S3_ROOT_PASSWORD=change-me
# Application account (created by the s3-init service, readwrite rights) used by the workers and MLflow.
S3_ACCESS_KEY=milady-app
S3_SECRET_KEY=change-me
S3_PORT=9000
S3_CONSOLE_PORT=9001
AWS_DEFAULT_REGION=us-east-1
# MinIO images (maintained community fork; see infra/README.md, "Object storage" section).
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
MC_IMAGE=pgsty/mc:RELEASE.2026-10-18T00-00-00Z

# --- External storage (optional) --------------------------------------------------------------
# To write the MFF files and checkpoints to a provider bucket instead of
# MinIO, uncomment and fill in the lines below. The provider keys go in
# MILADY_S3_ACCESS_KEY / MILADY_S3_SECRET_KEY (do NOT replace S3_ACCESS_KEY / S3_SECRET_KEY, which
# remain the MinIO account used by MLflow). Endpoints are given as examples: check the
# region and exact URL in the provider's documentation.
# MILADY_STORAGE_URI=s3://my-milady-bucket/data
# MILADY_MODELS_URI=s3://my-milady-bucket/models
# MILADY_S3_ACCESS_KEY=<provider access key>
# MILADY_S3_SECRET_KEY=<provider secret>
# MILADY_S3_ENDPOINT=https://s3.fr-par.scw.cloud        # Scaleway (Paris)
# MILADY_S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net    # OVHcloud (Gravelines)
# MILADY_S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com # AWS (Paris)

# --- MLflow ------------------------------------------------------------------------------------
MLFLOW_PORT=5000
MLFLOW_EXPERIMENT_NAME=milady
# MLFLOW_ARTIFACTS_DESTINATION=s3://mlflow
# Add a domain name here if MLflow is exposed behind a reverse proxy:
# MLFLOW_ALLOWED_HOSTS=mlflow,mlflow:*,localhost,localhost:*,127.0.0.1,127.0.0.1:*

# --- Jupyter ("jupyter" profile) --------------------------------------------------------------
JUPYTER_PORT=8888
JUPYTER_TOKEN=change-me
