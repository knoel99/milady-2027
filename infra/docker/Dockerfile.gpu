# syntax=docker/dockerfile:1.7
# GPU (CUDA) image of the MilaDy project: cloud GPU VM, and base of the Apptainer image for Slurm.
#
# Build (from the repository root):
#   docker build -f infra/docker/Dockerfile.gpu -t milady:gpu .
#   or: make image-gpu
#
# Base: official PyTorch image (Ubuntu 24.04, system Python 3.12, torch 2.14.1, CUDA 12.6,
# cuDNN 9). This Python is "externally managed" (PEP 668): inside a container we install
# with pip anyway (PIP_BREAK_SYSTEM_PACKAGES=1), which is the usual practice for these images.
# CUDA 12.6 works with an NVIDIA driver >= 525 (CUDA 12 minor-version compatibility) and covers
# V100, A100, L4, L40S, H100. For Blackwell GPUs (B200, RTX 50xx), choose a CUDA 13 base:
#   --build-arg BASE_IMAGE=pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
# (driver >= 580 required; then adapt torch in requirements-gpu.txt).
#
# Same options as the CPU Dockerfile: MILADY_UID, MILADY_GID, WITH_JUPYTER, GIT_COMMIT,
# --secret id=cacert,src=... (TLS proxy).

ARG BASE_IMAGE=pytorch/pytorch:2.14.1-cuda12.6-cudnn9-runtime
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    MILADY_ROOT=/opt/milady \
    MPLBACKEND=Agg \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends git make curl ca-certificates postgresql-client tini \
 && rm -rf /var/lib/apt/lists/*

# ARGs are declared as close as possible to where they are used: a different value only invalidates
# the build cache from this line onwards (apt and pip stay cached).
ARG MILADY_UID=1000
ARG MILADY_GID=1000

# Non-root user, aligned with the host UID/GID. Robust to IDs already taken in
# the base image (e.g. GID 20 on Macs, UID 1000 "ubuntu"): the group is reused, the
# existing user is renamed.
RUN set -eu; \
    [ "${MILADY_UID}" != "0" ] || { echo "MILADY_UID=0 refused: the container runs without root" >&2; exit 1; }; \
    getent group "${MILADY_GID}" >/dev/null || groupadd --gid "${MILADY_GID}" milady; \
    if getent passwd "${MILADY_UID}" >/dev/null; then \
        usermod -l milady -d /home/milady -m -g "${MILADY_GID}" "$(getent passwd "${MILADY_UID}" | cut -d: -f1)"; \
    else \
        useradd --uid "${MILADY_UID}" --gid "${MILADY_GID}" --create-home --shell /bin/bash milady; \
    fi

WORKDIR /opt/milady

# Pinned dependencies WITHOUT the CUDA stack (torch, triton, nvidia-*, cuda-*), already provided by
# the base image: we do not reinstall it, we only check the torch version.
COPY infra/env/requirements-gpu.txt /tmp/requirements-gpu.txt
ARG WITH_JUPYTER=0
RUN --mount=type=secret,id=cacert,required=false \
    if [ -s /run/secrets/cacert ]; then export PIP_CERT=/run/secrets/cacert; fi \
 && grep -vE '^(torch|triton|cuda-[a-z-]+|nvidia-[a-z0-9-]+-cu1[0-9])==' /tmp/requirements-gpu.txt \
      | grep -vE '^--extra-index-url' > /tmp/requirements-nocuda.txt \
 && pip install -r /tmp/requirements-nocuda.txt \
 && if [ "${WITH_JUPYTER}" = "1" ]; then pip install "jupyterlab==4.6.4"; fi \
 && python -c "import torch; v = torch.__version__.split('+')[0]; assert v == '2.14.1', v; print('torch', torch.__version__, 'cuda', torch.version.cuda)"

# Provenance: declared AFTER the dependencies, otherwise every new commit would reinstall torch.
ARG GIT_COMMIT=""
ENV MILADY_GIT_COMMIT=${GIT_COMMIT}
COPY --chown=${MILADY_UID}:${MILADY_GID} . /opt/milady
RUN --mount=type=secret,id=cacert,required=false \
    if [ -s /run/secrets/cacert ]; then export PIP_CERT=/run/secrets/cacert; fi \
 && pip install --no-deps -e . \
 && mkdir -p /opt/milady/data \
 && chown -R "${MILADY_UID}:${MILADY_GID}" /opt/milady \
 && python -c "import milady, h5py, torch; print('milady', milady.__version__)"

USER milady

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-c", "import torch; print('MilaDy image ready (GPU); CUDA visible:', torch.cuda.is_available())"]
